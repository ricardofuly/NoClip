# Texto: deixa como esta no disco (o projeto usa CRLF no Windows).
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Assets binarios do Unreal e fontes de arte: Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
